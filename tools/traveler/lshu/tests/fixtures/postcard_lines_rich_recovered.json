        {
          "id": "g.snow.04",
          "text": "呼出来的气是白的，像在跟自己说话。"
        },
        {
          "id": "g.snow.05",
          "text": "雪把声音都收走了，只剩一点风。",
          "motifs": [
            "wind"
          ]
        },
        {
          "id": "g.snow.06",
          "text": "手冻得有点僵，字写歪了，你将就看。"
        }
      ],
      "desert": [
        {
          "id": "g.desert.01",
          "text": "沙子很细，鞋里、兜里、眼镜缝里都有。",
          "motifs": [
            "glasses"
          ]
        },
        {
          "id": "g.desert.02",
          "text": "走在沙上，一步退半步，也算往前。"
        },
        {
          "id": "g.desert.03",
          "text": "风一吹，脚印就没了，好像我没来过。",
          "motifs": [
            "wind"
          ]
        },
        {
          "id": "g.desert.04",
          "text": "这里干得很，水要一口一口省着喝。",
          "motifs": [
            "drink"
          ]
        },
        {
          "id": "g.desert.05",
          "text": "远处的沙丘一道一道，像被人梳过。",
          "motifs": [
            "far"
          ]
        },
        {
          "id": "g.desert.06",
          "text": "这里空，空得让人想唱两句，想想还是算了。"
        }
      ],
      "grass": [
        {
          "id": "g.grass.01",
          "text": "草长得正好，踩上去软软的。"
        },
        {
          "id": "g.grass.02",
          "text": "树叶沙沙响，像在议论我这个过路的。"
        },
        {
          "id": "g.grass.03",
          "text": "空气里有青草味，还有一点泥土味。"
        },
        {
          "id": "g.grass.04",
          "text": "林子不深，走进去就听不见别的声音了。"
        },
        {
          "id": "g.grass.05",
          "text": "裤脚沾了草籽，一路带着走，也算帮它们搬了家。"
        },
        {
          "id": "g.grass.06",
          "text": "树底下落了一层叶子，踩上去有点可惜。"
        }
      ],
      "harbour": [
        {
          "id": "g.harbour.01",
          "text": "水声一直在，听久了，反倒觉得安静。"
        },
        {
          "id": "g.harbour.02",
          "text": "风里有股咸味，眼镜片上也蒙了一层。",
          "motifs": [
            "wind",
            "glasses"
          ]
        },
        {
          "id": "g.harbour.03",
          "text": "岸边的船一晃一晃，看久了我也有点晕。"
        },
        {
          "id": "g.harbour.04",
          "text": "浪一下一下拍过来，不紧不慢，跟我走路差不多。"
        },
        {
          "id": "g.harbour.05",
          "text": "水边的石头都磨圆了，没棱没角，挺好。",
          "motifs": [
            "stone"
          ]
        },
        {
          "id": "g.harbour.06",
          "text": "看水的人总是待得比别人久一点，我也一样。"
        }
      ],
      "rock": [
        {
          "id": "g.rock.01",
          "text": "岩壁很高，在它跟前，人就小了。"
        },
        {
          "id": "g.rock.02",
          "text": "石头上一层一层的纹，像年轮，年头更多。",
          "motifs": [
            "stone"
          ]
        },
        {
          "id": "g.rock.03",
          "text": "敲了敲石头，它没理我。",
          "motifs": [
            "stone"
          ]
        },
        {
          "id": "g.rock.04",
          "text": "对着石壁咳嗽一声，回声比我还响。"
        },
        {
          "id": "g.rock.05",
          "text": "石缝里长出一棵小草，比我能吃苦。"
        },
        {
          "id": "g.rock.06",
          "text": "石头路硌脚，得看着脚下，风景只好一会儿再看。",
          "motifs": [
            "stone",
            "path"
          ]
        }
      ],
      "city": [
        {
          "id": "g.city.01",
          "text": "石阶被人走得发亮，我也添了几步。"
        },
        {
          "id": "g.city.02",
          "text": "以前的人在这儿造了这么多东西，我连帐篷都搭不正。",
          "motifs": [
            "tent"
          ]
        },
        {
          "id": "g.city.03",
          "text": "石头上刻着我看不懂的字，我看得很认真。",
          "motifs": [
            "earnest"
          ]
        },
        {
          "id": "g.city.04",
          "text": "塔尖、屋顶、台阶，一样样看过去，脖子有点酸。"
        },
        {
          "id": "g.city.05",
          "text": "这里的路弯来弯去，我认路的本事又没派上用场。",
          "motifs": [
            "path"
          ]
        },
        {
          "id": "g.city.06",
          "text": "在这么老的地方，我算年轻的。"
        }
      ]
    },
    "road": [
      {
        "id": "r.01",
        "text": "走了挺长一段路，鞋底又薄了一层。",
        "motifs": [
          "shoes"
        ]
      },
      {
        "id": "r.02",
        "text": "路上没什么好说的，就是一步一步走。"
      },
      {
        "id": "r.03",
        "text": "走错了一个岔口，多看了一片风景，不亏。",
        "motifs": [
          "path"
        ]
      },
      {
        "id": "r.04",
        "text": "一个人赶路，话都说给自己听。"
      },
      {
        "id": "r.05",
        "text": "背包越走越轻，地图越走越皱。"
      },
      {
        "id": "r.06",
        "text": "一路顶着风走，风大概也有它要去的地方。",
        "motifs": [
          "wind"
        ]
      },
      {
        "id": "r.07",
        "text": "走累了就坐下，看看走过的路，再接着走。",
        "motifs": [
          "path"
        ]
      },
      {
        "id": "r.08",
        "text": "这段路很长，长到把想了很久的事都想完了。"
      },
      {
        "id": "r.09",
        "text": "路上最想写信，到了反倒忘了要说什么。"
      },
      {
        "id": "r.10",
        "text": "腿脚比前几年慢了，好在路也不催我。",
        "motifs": [
          "legs"
        ]
      }
    ],
    "home": [
      {
        "id": "h.01",
        "text": "回家了。先烧一壶水，别的明天再说。",
        "avoid": [
          "slot:morning"
        ]
      },
      {
        "id": "h.02",
        "text": "门推开时响了一声，像是认出我了。",
        "avoid": [
          "slot:morning"
        ]
      },
      {
        "id": "h.03",
        "text": "屋里的东西都在原处，就是灰多了一层。"
      },
      {
        "id": "h.04",
        "text": "鞋脱在门口，这一趟它比我辛苦。",
        "motifs": [
          "shoes"
        ]
      },
      {
        "id": "h.05",
        "text": "在自己家里，坐着都比别处踏实。"
      },
      {
        "id": "h.06",
        "text": "把这趟捡的小东西摆上窗台，窗台快放不下了。"
      },
      {
        "id": "h.07",
        "text": "炉子生上火，屋里慢慢有了木头的味道。",
        "motifs": [
          "fire"
        ]
      },
      {
        "id": "h.08",
        "text": "歇一晚就走。出门的人，回家也是为了再出门。"
      }
    ]
  }
}
