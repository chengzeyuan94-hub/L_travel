{
  "schema": "lshu.postcard_lines.v1",
  "version": "2026-09-24 draft 1",
  "status": "draft: Claude 起草，Carlos 改定。所有概率与窗口都是起点值，随时可调，不作为验收门槛。",
  "voice": {
    "who": "L叔：戴大眼镜的中年大叔，温和、话少、有点冷幽默，偶尔自嘲。",
    "rules": [
      "第一人称，短句，一行只说一件事，每行以句号结尾。",
      "每行不超过 limits.max_line_chars 个字符（含标点）。",
      "分类互不越界，这样任意两类拼在一起都不打架：时段句只写光、天色、空气；活动句只写他在做的事；地貌句只写脚下、水、石、雪、沙和这类地方的气味声音；路上句只写赶路；回家句只写家。",
      "不写地名、城名、编号、数字、日期；地名由邮戳负责。",
      "不写署名，「L」由界面落款。",
      "不用表情符号，不用网络流行语。"
    ]
  },
  "signature": {
    "text": "L",
    "rendered_by": "ui",
    "note": "句子里从不出现署名或「L叔」。"
  },
  "limits": {
    "max_line_chars": 26,
    "max_card_chars": 50,
    "max_lines_per_card": 2,
    "no_repeat_window_cards": 20
  },
  "input_contract": {
    "note": "组合一张明信片时，导演脚本需要给出下面这些上下文。字段按列出的顺序取第一个非空值；pool.* 指 data/traveler/lshu/pool.json 里这一站的条目，tile.* 指该地块的 lshu.tile.v1 JSON。本文件不认识任何地块或地点编号。",
    "slot": {
      "required": true,
      "values": [
        "morning",
        "day",
        "sunset",
        "night"
      ],
      "source": "拍明信片那一刻的循环时钟时段（loop.json 的光照时段窗口），不用配方里的 light 字段。",
      "aliases": {
        "dusk": "sunset",
        "evening": "sunset",
        "noon": "day",
        "dawn": "morning"
      }
    },
    "kit": {
      "required": true,
      "source": [
        "pool.kit",
        "tile.kit.mode",
        "tile.kit.id"
      ],
      "note": "取值可以是字符串或 0–3 的整数，按 kits.*.aliases 归一。Godot 的 JSON 会把整数读成 float，比较前先转成 int。"
    },
    "biome": {
      "required": true,
      "source": [
        "pool.biome",
        "tile.place.theme"
      ],
      "note": "网页配方的 theme：snow / desert / autumn / harbor；也接受 terrain_resolve.from_biome 里列出的别名。"
    },
    "landform": {
      "required": false,
      "source": [
        "pool.landform",
        "tile.place.landform"
      ]
    },
    "city": {
      "required": false,
      "source": [
        "pool.city_id",
        "tile.place.city"
      ],
      "note": "pool.city_id 是 city_lore_v1.json 的 city_id；tile.place.city 是城市中文名，经 cities.json 的 display_name 换成 id。两者都空就是自然地点。"
    },
    "postcard_terrain": {
      "required": false,
      "source": [
        "pool.postcard_terrain"
      ],
      "note": "可选的覆盖值，Array[String]，取值为 terrain_groups 的键。给了就不再推算地貌组。"
    },
    "place_name": {
      "required": true,
      "source": [
        "pool.place_name",
        "tile.place.name"
      ],
      "note": "只给邮戳用，不进句子。"
    },
    "sub": {
      "required": false,
      "source": [
        "pool.sub"
      ],
      "note": "网页 places[].sub。只对自然地点当邮戳副题用；城市地点的 sub 是免责说明，不用。"
    },
    "is_home": {
      "required": true,
      "source": [
        "pool.is_home",
        "stop.home"
      ]
    },
    "is_overnight": {
      "required": true,
      "source": [
        "stop.night"
      ]
    },
    "after_long_road": {
      "required": true,
      "source": [
        "stop.long_road"
      ],
      "note": "到这一站之前走的是「远路」（loop.json 的长路段）。"
    },
    "minutes_since_arrive": {
      "required": true,
      "source": [
        "(card_unix - stop.arrive) / 60"
      ]
    },
    "history": {
      "required": true,
      "source": [
        "save.postcards[-20:].line_ids"
      ],
      "note": "最近 20 张明信片用过的句子编号。"
    },
    "rng": {
      "required": true,
      "source": [
        "hash(save.seed, leg_index, card_index_in_leg, step)"
      ],
      "note": "只要求同一存档、同一站、同一张卡结果一致；不要求和 Python 参考实现逐位相同。"
    }
  },
  "kits": {
    "look": {
      "label": "远望",
      "aliases": [
        "look",
        0
      ]
    },
    "camp": {
      "label": "扎营",
      "aliases": [
        "camp",
        1
      ]
    },
    "tea": {
      "label": "喝茶",
      "aliases": [
        "tea",
        2
      ]
    },
    "bloom": {
      "label": "拾花",
      "aliases": [
        "bloom",
        "encounter",
        3
      ]
    }
  },
  "terrain_groups": {
    "snow": {
      "label": "雪"
    },
    "desert": {
      "label": "沙"
    },
    "grass": {
      "label": "草木"
    },
    "harbour": {
      "label": "水岸"
    },
    "rock": {
      "label": "山石"
    },
    "city": {
      "label": "城"
    }
  },
  "terrain_resolve": {
    "note": "一站的地貌标签 = postcard_terrain（若给出）；否则 = [city（若是城市地点）] + from_landform[landform] + from_biome[biome]，去重。与地点编号同名的地形取值故意不列；需要时在 pool.json 里用 postcard_terrain 补。",
    "from_biome": {
      "snow": "snow",
      "desert": "desert",
      "sand": "desert",
      "autumn": "grass",
      "grass": "grass",
      "forest": "grass",
      "harbor": "harbour",
      "harbour": "harbour",
      "water": "harbour",
      "rock": "rock"
    },
    "from_landform": {
      "ridge": "rock",
      "ruin": "rock",
      "basin": "rock",
      "headland": "rock",
      "dune": "desert",
      "grove": "grass",
      "shore": "harbour"
    },
    "fallback": "grass",
    "pick": {
      "city_weight": 0.5,
      "note": "城市地点抽到「城」的概率 0.5，其余概率在自然标签之间平分；自然地点在自己的标签之间平分。"
    }
  },
  "compose": {
    "summary": "每张明信片 1–2 句。先定主句的类别，再按概率补一句别的类别；两句不同类、不共享母题、不重复最近 20 张用过的句子；按固定顺序排好，用换行连接。",
    "steps": [
      "1. 归一上下文：slot、kit 按别名归一；按 terrain_resolve 得到地貌标签。",
      "2. 定主句类别：is_home 为真 → home。否则 after_long_road 为真且 minutes_since_arrive ≤ 20 时，以 primary.road_after_long_road.p 取 road。否则 minutes_since_arrive ≤ 10 时，以 primary.road_fresh_arrival.p 取 road。仍未定的，按 primary.weights（过夜站用 primary.weights_overnight）在 terrain 与 kit 之间抽。",
      "3. 选主句：terrain 类先按 terrain_resolve.pick 抽一个地貌组，kit 类用当前配景，然后在该组里抽一句。",
      "4. 是否补第二句：以 second_line.p（home 用 second_line.p_home）决定；补的话按 second_line.weights_by_primary[主句类别] 抽类别，且不能和主句同类。time 类用当前 slot 的句组。",
      "5. 过滤：候选句先去掉 history 里出现过的；再去掉 avoid 命中当前上下文的（写法 slot:xxx / terrain:xxx / kit:xxx，terrain 指本张卡实际抽中的地貌组或该站全部地貌标签）；第二句还要去掉与主句共享 motifs 的。",
      "6. 兜底：某组过滤后为空时，忽略 history，取该组里最久没用过的一句（仍遵守 avoid 和母题）；还是空的话，主句忽略母题，第二句直接放弃。",
      "7. 超长：两句连起来超过 limits.max_card_chars 时，换一次第二句；仍超长就只留主句。",
      "8. 排序与连接：按 card_order 排，用 joiner 连接。把两句的 id 写进这张明信片的 line_ids，供之后的去重。"
    ],
    "primary": {
      "road_after_long_road": {
        "p": 0.7,
        "max_minutes_since_arrive": 20
      },
      "road_fresh_arrival": {
        "p": 0.1,
        "max_minutes_since_arrive": 10
      },
      "weights": {
        "terrain": 0.5,
        "kit": 0.5
      },
      "weights_overnight": {
        "terrain": 0.4,
        "kit": 0.6
      }
    },
    "second_line": {
      "p": 0.65,
      "p_home": 0.5,
      "weights_by_primary": {
        "terrain": {
          "time": 0.6,
          "kit": 0.4
        },
        "kit": {
          "time": 0.6,
          "terrain": 0.4
        },
        "road": {
          "time": 0.5,
          "terrain": 0.5
        },
        "home": {
          "time": 1.0
        }
      }
    },
    "card_order": [
      "time",
      "road",
      "home",
      "terrain",
      "kit"
    ],
    "joiner": "\n",
    "away_card": {
      "note": "「你不在的时候」小卡：地名清单由导演脚本给出，本文件只提供一句 road 类的话，不加时段句，同样遵守 20 张去重。",
      "category": "road",
      "lines": 1
    }
  },
  "stamp": {
    "note": "邮戳不在句库里生成句子，这里只记录取数规则，供界面使用。",
    "title_source": [
      "pool.place_name",
      "tile.place.name"
    ],
    "date_format": "{year}年{month}月{day}日",
    "slot_labels": {
      "morning": "晨",
      "day": "昼",
      "sunset": "昏",
      "night": "夜"
    },
    "home_mark": "家",
    "caption": {
      "city": "城市地点：city_lore 的称号（epithet）。",
      "natural": "自然地点：pool.sub（网页 places[].sub），没有就不写。",
      "never": "城市地点不用网页的 sub，那是免责说明。"
    },
    "city_lookup": {
      "lore_file": "res://data/rulesets/lshu_configurable_v1/presentation/city_lore_v1.json",
      "cities_file": "res://data/rulesets/lshu_configurable_v1/cities.json",
      "id_from": [
        "pool.city_id",
        "cities_file items[].id where items[].display_name == tile.place.city"
      ],
      "match": "lore_file items[].city_id == id",
      "field": "items[].epithet",
      "status_field": "items[].verification_status",
      "blocked_status": "CONTENT_BLOCKED",
      "blocked_policy": "omit",
      "blocked_note": "称号处于 CONTENT_BLOCKED 的城市，邮戳只写地名、不写称号，等 Carlos 裁决后把 blocked_policy 改成 show 即可。两个文件都只读。"
    }
  },
